@model SimplCommerce.Module.Catalog.Areas.Catalog.ViewModels.ProductWidgetComponentVm

<h2>@Model.WidgetName</h2>
<div class="row product-list" id="product-widget-@Model.Id">
    @foreach (var product in Model.Products.Take(100))
    {
        <div class="col-xs-6 col-md-3 product-item" data-product-id="@product.Id">
            <partial name="/Areas/Catalog/Views/Shared/_ProductThumbnail.cshtml" model="product" />
        </div>
    }
</div>

@if (Model.Products.Count >= 100)
{
    <div class="text-center mt-4 mb-4">
        <button class="btn btn-primary btn-lg" id="load-more-@Model.Id" onclick="loadMoreProducts(@Model.Id)">
            <i class="fa fa-plus-circle"></i> Load More Products (100)
        </button>
        <div id="loading-@Model.Id" class="d-none">
            <i class="fa fa-spinner fa-spin"></i> Loading...
        </div>
    </div>
}

<script>
var currentOffset_@Model.Id = 100; // Already loaded 100 products
var isLoading_@Model.Id = false;

function loadMoreProducts(widgetId) {
    if (isLoading_@Model.Id) return;
    
    isLoading_@Model.Id = true;
    document.getElementById('load-more-' + widgetId).classList.add('d-none');
    document.getElementById('loading-' + widgetId).classList.remove('d-none');
    
    fetch('/api/products/latest?offset=' + currentOffset_@Model.Id + '&limit=100')
        .then(response => response.json())
        .then(data => {
            if (data.length > 0) {
                const container = document.getElementById('product-widget-' + widgetId);
                data.forEach(product => {
                    const productHtml = `
                        <div class="col-xs-6 col-md-3 product-item" data-product-id="${product.id}">
                            <div class="thumbnail">
                                <a href="/product/${product.slug}">
                                    <img src="${product.thumbnailUrl || '/images/no-image.png'}" alt="${product.name}" class="img-fluid" />
                                </a>
                                <div class="caption">
                                    <h4><a href="/product/${product.slug}">${product.name}</a></h4>
                                    <p class="price">${product.calculatedProductPrice ? product.calculatedProductPrice.priceString : ''}</p>
                                </div>
                            </div>
                        </div>
                    `;
                    container.insertAdjacentHTML('beforeend', productHtml);
                });
                
                currentOffset_@Model.Id += data.length;
                
                document.getElementById('load-more-' + widgetId).classList.remove('d-none');
                document.getElementById('loading-' + widgetId).classList.add('d-none');
                isLoading_@Model.Id = false;
            } else {
                document.getElementById('loading-' + widgetId).innerHTML = '<p class="text-muted">No more products to load</p>';
            }
        })
        .catch(error => {
            console.error('Error loading products:', error);
            document.getElementById('load-more-' + widgetId).classList.remove('d-none');
            document.getElementById('loading-' + widgetId).classList.add('d-none');
            isLoading_@Model.Id = false;
            alert('Failed to load more products. Please try again.');
        });
}
</script>
